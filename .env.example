# Copy to .env and fill in. Never commit .env.

# LLM (Groq: https://groq.com, free tier)
GROQ_API_KEY=your-groq-api-key
MODEL_PRIMARY=openai/gpt-oss-120b
MODEL_FALLBACK=qwen/qwen3-32b

# Hindsight Configuration (Vectorize)
# Choose one of the following endpoints:

# Option A: Hindsight Inference API (Cohere-compatible semantic reranking with hs-decide-1-flash)
# HINDSIGHT_BASE_URL=https://inference.hindsight.vectorize.io/v1
# HINDSIGHT_API_KEY=hsk_your-hindsight-inference-key
# HINDSIGHT_RERANK_MODEL=hs-decide-1-flash

# Option B: Hindsight Cloud Memory Banks (https://ui.hindsight.vectorize.io)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your-hindsight-api-key

# Option C: Self-Hosted Hindsight instance
# HINDSIGHT_BASE_URL=http://localhost:8888

# One bank per team/workspace. Memories are isolated per bank.
HINDSIGHT_BANK_ID=oncall-incidents

# Optional tuning
# HINDSIGHT_RETAIN_ASYNC=false   # true = faster retain, but recall may not see it immediately
# RECALL_MAX_RESULTS=6
# LLM_TIMEOUT=30
# HINDSIGHT_TIMEOUT=60
